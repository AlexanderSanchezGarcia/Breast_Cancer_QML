# Ignore Data Folder
Data/

# LaTeX: se versionan las fuentes (.tex, .bib), las figuras y el PDF compilado.
# Solo se ignoran los auxiliares que regenera cada compilacion.
Docs/*.aux
Docs/*.log
Docs/*.fls
Docs/*.fdb_latexmk
Docs/*.out
Docs/*.toc
Docs/*.lof
Docs/*.lot
Docs/*.synctex.gz
Docs/*.bbl
Docs/*.blg
Docs/*.bcf
Docs/*.run.xml

# Ignore CLAUDE.md file
CLAUDE.md

# macOS
.DS_Store

# Python
__pycache__/

# PDF de referencias (derechos de autor) y su texto extraído
Docs/fuentes/

# Auxiliares de los borradores por capítulo
Docs/capitulos/_build/

# PDF de los borradores: se regeneran con compilar_borradores.sh
Docs/capitulos/borrador_completo.pdf
Docs/capitulos/*/borrador_*.pdf
Docs/insumos/noche/*.pdf

# Protocolo firmado (datos personales; el repositorio es público)
Other/ESCOM/Protocolo.pdf

# Cartas firmadas que se integran al reporte
Docs/preliminares/*.pdf
Docs/*.lol

# Formatos llenados (datos personales)
Docs/preliminares/borradores/
